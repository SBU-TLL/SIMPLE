###############################################################################
# SIMPLE — production environment template
#
# Copy to your runtime secret store / Azure container env (do NOT commit a real
# .env). Values here are PLACEHOLDERS. SIMPLE has NO database and NO application
# secrets. This template documents the platform/auth contract and the external
# dependencies.
#
# Nothing here is baked into the image; the dev-only Shibboleth mock lives under
# .ddev/ and is excluded (.dockerignore).
###############################################################################

# --- Environment flag --------------------------------------------------------
# Must never be "local" in prod (the .ddev mock keys on it; it is absent here).
APP_ENV=production
TZ=America/New_York

# --- Ingress / routing -------------------------------------------------------
PUBLIC_HOSTNAME=simple.<your-subdomain>.stonybrook.edu
# Apache listens on 8080 inside the container (non-root); ingress forwards
# 443 -> 8080. "/" serves index.php.
APACHE_LISTEN_PORT=8080

# --- Authentication (Shibboleth at the ingress) ------------------------------
# The landing pages are public; the served subdirs (resourcesSource/,
# media/archive/*) and the upload pipeline use Shibboleth (cn). Shibboleth is
# enforced at the ingress / reverse proxy (Ansible-managed), which supplies
# $_SERVER['cn']. The <IfModule mod_shib> guards are inert without mod_shib.
#   -> The Azure/Ansible deploy MUST assert mod_shib is loaded at the gate.

# --- EXTERNAL internal-project dependencies (must be co-served) ---------------
# SIMPLE references two internal projects by ABSOLUTE URL; they are NOT bundled
# in this image and must be served at the SAME ORIGIN (deploy them there / route
# these paths via the ingress) or they degrade:
#   * /fonts/FuturaPT{Book,Medium,Demi}.otf  — the internal "fonts" project
#     (css/style.css @font-face). Missing -> text falls back to a default font.
#   * /login/js/lti.js                       — the internal "login" project
#     (resourcesSource/index.html). Missing -> the LTI script 404s.
# (Alternatively, copy those assets into this repo and switch the CSS/HTML to
#  relative paths — the "vendor per project" approach.)

# --- Uploads / storage -------------------------------------------------------
# Per-user PSD uploads + processed output go to uploads/ -> ../userData/SIMPLE/
# uploads (outside the web root). Mount a persistent volume so they survive
# redeploys:
#   docker run -v simple-uploads:/var/www/userData/SIMPLE/uploads ...
# The pipeline shells out to ImageMagick (convert/identify) + python3 (numpy) —
# both are installed in the image.

# --- Database / secrets ------------------------------------------------------
# NONE. NOTE: pages/processor.php builds shell commands from $_SERVER['cn']-
# derived paths (cn is a trusted Shibboleth netID, but validate/escape before
# Azure). grades.csv (student PII) was committed to VCS — excluded from the
# image; purge it from history.
